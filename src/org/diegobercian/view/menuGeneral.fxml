<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import org.diegobercian.ui.ResponsiveGrid?>
<?import org.diegobercian.ui.ResponsivePair?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" minWidth="0" styleClass="home-root" stylesheets="@../resourse/SuperKinalCSS.css" fx:controller="org.diegobercian.controller.MenuPrincipalController" xmlns="http://javafx.com/javafx/8.0.202">
  <top>
    <VBox spacing="0" styleClass="home-header">
      <MenuBar>
        <menus>
          <Menu text="Módulos">
            <items>
              <MenuItem fx:id="btnMenuClientes" text="Clientes" onAction="#handleButtonAction" />
              <MenuItem fx:id="btnMenuCompras" text="Compras" onAction="#handleButtonAction" />
              <MenuItem fx:id="btnMenuProveedor" text="Proveedores" onAction="#handleButtonAction" />
              <MenuItem fx:id="btnMenuProductos" text="Productos" onAction="#handleButtonAction" />
              <MenuItem fx:id="btnMenuTipoProducto" text="Tipos de producto" onAction="#handleButtonAction" />
              <MenuItem fx:id="btnMenuEmpleados" text="Empleados" onAction="#handleButtonAction" />
              <MenuItem fx:id="btnMenuFacturas" text="Facturas" onAction="#handleButtonAction" />
            </items>
            <graphic>
              <ImageView fitWidth="19" fitHeight="19" preserveRatio="true" mouseTransparent="true">
                <image>
                  <Image url="@../images/modulos.png" />
                </image>
              </ImageView>
            </graphic>
          </Menu>
          <Menu text="Reportes">
            <items>
              <MenuItem fx:id="btnClientesR" text="Clientes Reportes" onAction="#handleButtonAction" />
              <MenuItem fx:id="btnProductosR" text="Productos Reportes" onAction="#handleButtonAction" />
              <MenuItem fx:id="btnProveedoresR" text="Proveedores Reportes" onAction="#handleButtonAction" />
            </items>
            <graphic>
              <ImageView fitWidth="19" fitHeight="19" preserveRatio="true" mouseTransparent="true">
                <image>
                  <Image url="@../images/reporte.png" />
                </image>
              </ImageView>
            </graphic>
          </Menu>
          <Menu text="Acerca de">
            <items>
              <MenuItem fx:id="btnVistaProgramador" text="Sobre mí" onAction="#handleButtonAction" />
            </items>
            <graphic>
              <ImageView fitWidth="19" fitHeight="19" preserveRatio="true" mouseTransparent="true">
                <image>
                  <Image url="@../images/info.png" />
                </image>
              </ImageView>
            </graphic>
          </Menu>
          <Menu text="Usuario">
            <graphic>
              <ImageView fitWidth="19" fitHeight="19" preserveRatio="true" mouseTransparent="true">
                <image>
                  <Image url="@../images/usuarios2.png" />
                </image>
              </ImageView>
            </graphic>
            <items>
              <MenuItem fx:id="btnSesionCerrar" text="Cerrar Sesión" onAction="#handleButtonAction" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
    </VBox>
  </top>
  <center>
    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER">
      <content>
        <VBox spacing="20" minWidth="0" styleClass="home-body">
          <ResponsiveGrid maxColumns="2">
            <children>
              <Button fx:id="btnCompras" text="Compras" onAction="#handleButtonAction" styleClass="Button,module-card" minWidth="0" maxWidth="Infinity" prefHeight="125" wrapText="true">
                <graphic>
                  <ImageView fitWidth="62" fitHeight="62" preserveRatio="true" mouseTransparent="true">
                    <image>
                      <Image url="@../images/carrito.png" />
                    </image>
                  </ImageView>
                </graphic>
              </Button>
              <Button fx:id="btnMenuUbicaciones" text="Ubicaciones" onAction="#handleButtonAction" styleClass="Button,module-card" minWidth="0" maxWidth="Infinity" prefHeight="125" wrapText="true">
                <graphic>
                  <ImageView fitWidth="62" fitHeight="62" preserveRatio="true" mouseTransparent="true">
                    <image>
                      <Image url="@../images/ubicacion.png" />
                    </image>
                  </ImageView>
                </graphic>
              </Button>
              <Button fx:id="btnMenuHorarios" text="Horarios" onAction="#handleButtonAction" styleClass="Button,module-card" minWidth="0" maxWidth="Infinity" prefHeight="125" wrapText="true">
                <graphic>
                  <ImageView fitWidth="62" fitHeight="62" preserveRatio="true" mouseTransparent="true">
                    <image>
                      <Image url="@../images/hora.png" />
                    </image>
                  </ImageView>
                </graphic>
              </Button>
              <Button fx:id="btnClientes" text="Clientes" onAction="#handleButtonAction" styleClass="Button,module-card" minWidth="0" maxWidth="Infinity" prefHeight="125" wrapText="true">
                <graphic>
                  <ImageView fitWidth="62" fitHeight="62" preserveRatio="true" mouseTransparent="true">
                    <image>
                      <Image url="@../images/usuarios.png" />
                    </image>
                  </ImageView>
                </graphic>
              </Button>
            </children>
          </ResponsiveGrid>
        </VBox>
      </content>
    </ScrollPane>
  </center>
</BorderPane>
