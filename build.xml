<project name="SuperKinal" default="jar" basedir=".">
  <condition property="maven.executable" value="mvn.cmd" else="mvn"><os family="windows"/></condition>
  <target name="clean"><exec executable="${maven.executable}" failonerror="true"><arg value="clean"/></exec></target>
  <target name="jar"><exec executable="${maven.executable}" failonerror="true"><arg value="verify"/></exec></target>
  <target name="test"><exec executable="${maven.executable}" failonerror="true"><arg value="test"/></exec></target>
  <target name="run" depends="jar"><java jar="target/superkinal-2.0.0.jar" fork="true" failonerror="true"/></target>
</project>
