<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import org.diegobercian.ui.ResponsiveGrid?>
<?import org.diegobercian.ui.ResponsivePair?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" minWidth="0" styleClass="app-root" stylesheets="@../resourse/SuperKinalCSS.css" fx:controller="org.diegobercian.controller.MenuFacturaController" xmlns="http://javafx.com/javafx/8.0.202">
  <top>
    <VBox spacing="12" styleClass="page-header">
      <HBox alignment="CENTER" spacing="16" minWidth="0">
        <ImageView fitWidth="104" fitHeight="68" preserveRatio="true" mouseTransparent="true">
          <image>
            <Image url="@../images/logo2.png" />
          </image>
        </ImageView>
        <Label text="Facturas" styleClass="page-title" wrapText="true" minHeight="-Infinity" minWidth="0" />
      </HBox>
    </VBox>
  </top>
  <center>
    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="page-scroll">
      <content>
        <VBox spacing="16" fillWidth="true" minWidth="0" styleClass="page-body">
          <ResponsiveGrid fx:id="formGrid">
            <children>
              <VBox spacing="6" minWidth="0" styleClass="field-cell">
                <Label text="Número de factura (automático)" styleClass="field-label" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity" />
                <TextField fx:id="txtNumero" minWidth="0" maxWidth="Infinity" prefHeight="38" />
              </VBox>
              <VBox spacing="6" minWidth="0" styleClass="field-cell">
                <Label text="Estado *" styleClass="field-label" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity" />
                <TextField fx:id="txtEstado" minWidth="0" maxWidth="Infinity" prefHeight="38" />
              </VBox>
              <VBox spacing="6" minWidth="0" styleClass="field-cell">
                <Label text="Fecha de factura *" styleClass="field-label" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity" />
                <DatePicker fx:id="txtFecha" minWidth="0" maxWidth="Infinity" prefHeight="38" />
              </VBox>
              <VBox spacing="6" minWidth="0" styleClass="field-cell">
                <Label text="Cliente *" styleClass="field-label" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity" />
                <ComboBox fx:id="cmbClientes" minWidth="0" maxWidth="Infinity" prefHeight="38" />
              </VBox>
              <VBox spacing="6" minWidth="0" styleClass="field-cell">
                <Label text="Empleado *" styleClass="field-label" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity" />
                <ComboBox fx:id="cmbEmpleados" minWidth="0" maxWidth="Infinity" prefHeight="38" />
              </VBox>
            </children>
          </ResponsiveGrid>
          <ResponsivePair firstWidth="168" breakpoint="790" gap="16" VBox.vgrow="ALWAYS">
            <TilePane tileAlignment="CENTER" alignment="TOP_LEFT" hgap="8" vgap="8" prefColumns="1" prefTileWidth="142" minWidth="0">
              <Button fx:id="btnAgregar" text="Agregar" onAction="#agregar" styleClass="Button" minHeight="46" minWidth="92" wrapText="true" maxWidth="Infinity">
                <graphic>
                  <ImageView fitWidth="28" fitHeight="28" preserveRatio="true" mouseTransparent="true">
                    <image>
                      <Image url="@../images/agregar.png" />
                    </image>
                  </ImageView>
                </graphic>
              </Button>
              <Button fx:id="btnEditar" text="Editar" onAction="#editar" styleClass="Button" minHeight="46" minWidth="92" wrapText="true" maxWidth="Infinity">
                <graphic>
                  <ImageView fitWidth="28" fitHeight="28" preserveRatio="true" mouseTransparent="true">
                    <image>
                      <Image url="@../images/editar.png" />
                    </image>
                  </ImageView>
                </graphic>
              </Button>
              <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminar" styleClass="Button" minHeight="46" minWidth="92" wrapText="true" maxWidth="Infinity">
                <graphic>
                  <ImageView fitWidth="28" fitHeight="28" preserveRatio="true" mouseTransparent="true">
                    <image>
                      <Image url="@../images/eliminar.png" />
                    </image>
                  </ImageView>
                </graphic>
              </Button>
              <Button fx:id="btnReportes" text="Reportes" onAction="#reportes" styleClass="Button" minHeight="46" minWidth="92" wrapText="true" maxWidth="Infinity">
                <graphic>
                  <ImageView fitWidth="28" fitHeight="28" preserveRatio="true" mouseTransparent="true">
                    <image>
                      <Image url="@../images/buscar.png" />
                    </image>
                  </ImageView>
                </graphic>
              </Button>
              <MenuButton text="Regresar" minHeight="46" styleClass="Button">
                <items>
                  <MenuItem fx:id="btnRegresar" text="Menu Principal" onAction="#handleButtonAction" />
                  <MenuItem fx:id="btnDetalleFactura" text="Detalle Factura" onAction="#handleButtonAction" />
                </items>
                <graphic>
                  <ImageView fitWidth="26" fitHeight="26" preserveRatio="true" mouseTransparent="true">
                    <image>
                      <Image url="@../images/atras.png" />
                    </image>
                  </ImageView>
                </graphic>
              </MenuButton>
            </TilePane>
            <VBox spacing="10" minWidth="0" VBox.vgrow="ALWAYS">
              <TableView fx:id="tblFacturas" minWidth="0" minHeight="220" prefHeight="320" maxHeight="Infinity" editable="false" VBox.vgrow="ALWAYS" styleClass="tabla">
                <columns>
                  <TableColumn fx:id="colNumero" text="Número de factura" minWidth="85" prefWidth="153" editable="false" />
                  <TableColumn fx:id="colEstado" text="Estado" minWidth="85" prefWidth="110" editable="false" />
                  <TableColumn fx:id="colTotal" text="Total de factura" minWidth="85" prefWidth="144" editable="false" />
                  <TableColumn fx:id="colFecha" text="Fecha de factura" minWidth="85" prefWidth="144" editable="false" />
                  <TableColumn fx:id="colCliente" text="Código de cliente" minWidth="85" prefWidth="153" editable="false" />
                  <TableColumn fx:id="colEmpleado" text="Empleado" minWidth="85" prefWidth="110" editable="false" />
                </columns>
              </TableView>
            </VBox>
          </ResponsivePair>
        </VBox>
      </content>
    </ScrollPane>
  </center>
</BorderPane>
