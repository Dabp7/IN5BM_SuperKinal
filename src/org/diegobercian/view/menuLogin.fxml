<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import org.diegobercian.ui.ResponsiveGrid?>
<ScrollPane xmlns="http://javafx.com/javafx/8.0.202" xmlns:fx="http://javafx.com/fxml/1" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="auth-root" stylesheets="@../resourse/App.css" fx:controller="org.diegobercian.controller.MenuLoginController">
  <content>
    <StackPane styleClass="auth-shell">
      <VBox spacing="18" minWidth="0" maxWidth="440" maxHeight="-Infinity" styleClass="auth-card">
        <Label text="SUPERKINAL" styleClass="brand" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity"/>
        <Label text="Bienvenido" styleClass="page-title" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity"/>
        <Label text="Ingresa con tu usuario para continuar." styleClass="muted" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity"/>
        <VBox spacing="6">
          <Label text="Usuario" styleClass="field-label" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity"/>
          <TextField fx:id="txtCorreo" promptText="Tu nombre de usuario" minWidth="0" prefHeight="40"/>
        </VBox>
        <VBox spacing="6">
          <Label text="Contraseña" styleClass="field-label" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity"/>
          <PasswordField fx:id="txtContra" promptText="Tu contraseña" minWidth="0" prefHeight="40"/>
        </VBox>
        <FlowPane hgap="10" vgap="10">
          <Button fx:id="btnInicio" text="Iniciar sesión" onAction="#validaUsuario" styleClass="primary-button" minHeight="38" minWidth="92" wrapText="true"/>
          <Button fx:id="btnRegistro" text="Crear cuenta" onAction="#handleButtonAction" styleClass="button" minHeight="38" minWidth="92" wrapText="true"/>
        </FlowPane>
      </VBox>
    </StackPane>
  </content>
</ScrollPane>
