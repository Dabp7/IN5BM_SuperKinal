<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import org.diegobercian.ui.ResponsiveGrid?>
<BorderPane xmlns="http://javafx.com/javafx/8.0.202" xmlns:fx="http://javafx.com/fxml/1" minWidth="0" styleClass="app-root" stylesheets="@../resourse/App.css" fx:controller="org.diegobercian.controller.MenuHorariosController">
  <top>
    <VBox spacing="12" styleClass="page-header">
      <Label text="Horarios" styleClass="page-title" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity"/>
      <Button fx:id="btnRegresar" text="Volver al inicio" onAction="#handleButtonAction" styleClass="button" minHeight="38" minWidth="92" wrapText="true"/>
    </VBox>
  </top>
  <center>
    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER">
      <content>
        <VBox spacing="18" minWidth="0" styleClass="page-body">
          <Label text="De lunes a domingo" styleClass="info-line" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity"/>
          <Label text="Mañanas: 6 a. m. a 11 a. m." styleClass="info-line" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity"/>
          <Label text="Tardes: 2 p. m. a 8 p. m." styleClass="info-line" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity"/>
          <Label text="Los horarios pueden cambiar durante los días festivos." styleClass="info-line" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity"/>
        </VBox>
      </content>
    </ScrollPane>
  </center>
</BorderPane>
