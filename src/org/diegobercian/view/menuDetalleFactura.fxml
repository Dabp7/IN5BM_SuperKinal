<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import org.diegobercian.ui.ResponsiveGrid?>
<?import org.diegobercian.ui.ResponsivePair?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" minWidth="0" styleClass="app-root" stylesheets="@../resourse/SuperKinalCSS.css" fx:controller="org.diegobercian.controller.MenuDetalleFacturaController" xmlns="http://javafx.com/javafx/8.0.202">
  <top>
    <VBox spacing="12" styleClass="page-header">
      <HBox alignment="CENTER" spacing="16" minWidth="0">
        <ImageView fitWidth="104" fitHeight="68" preserveRatio="true" mouseTransparent="true">
          <image>
            <Image url="@../images/logo2.png" />
          </image>
        </ImageView>
        <Label text="Detalles de factura" styleClass="page-title" wrapText="true" minHeight="-Infinity" minWidth="0" />
      </HBox>
    </VBox>
  </top>
  <center>
    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="page-scroll">
      <content>
        <VBox spacing="16" fillWidth="true" minWidth="0" styleClass="page-body">
          <ResponsiveGrid fx:id="formGrid">
            <children>
              <VBox spacing="6" minWidth="0" styleClass="field-cell">
                <Label text="Código de detalle (automático)" styleClass="field-label" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity" />
                <TextField fx:id="txtCodigo" minWidth="0" maxWidth="Infinity" prefHeight="38" />
              </VBox>
              <VBox spacing="6" minWidth="0" styleClass="field-cell">
                <Label text="Cantidad *" styleClass="field-label" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity" />
                <TextField fx:id="txtCantidad" minWidth="0" maxWidth="Infinity" prefHeight="38" />
              </VBox>
              <VBox spacing="6" minWidth="0" styleClass="field-cell">
                <Label text="Número de factura *" styleClass="field-label" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity" />
                <ComboBox fx:id="cmbNoF" minWidth="0" maxWidth="Infinity" prefHeight="38" />
              </VBox>
              <VBox spacing="6" minWidth="0" styleClass="field-cell">
                <Label text="Producto *" styleClass="field-label" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity" />
                <ComboBox fx:id="cmbCodigoP" minWidth="0" maxWidth="Infinity" prefHeight="38" />
              </VBox>
            </children>
          </ResponsiveGrid>
          <ResponsivePair firstWidth="168" breakpoint="790" gap="16" VBox.vgrow="ALWAYS">
            <TilePane tileAlignment="CENTER" alignment="TOP_LEFT" hgap="8" vgap="8" prefColumns="1" prefTileWidth="142" minWidth="0">
              <Button fx:id="btnAgregar" text="Agregar" onAction="#agregar" styleClass="Button" minHeight="46" minWidth="92" wrapText="true" maxWidth="Infinity">
                <graphic>
                  <ImageView fitWidth="28" fitHeight="28" preserveRatio="true" mouseTransparent="true">
                    <image>
                      <Image url="@../images/agregar.png" />
                    </image>
                  </ImageView>
                </graphic>
              </Button>
              <Button fx:id="btnEditar" text="Editar" onAction="#editar" styleClass="Button" minHeight="46" minWidth="92" wrapText="true" maxWidth="Infinity">
                <graphic>
                  <ImageView fitWidth="28" fitHeight="28" preserveRatio="true" mouseTransparent="true">
                    <image>
                      <Image url="@../images/editar.png" />
                    </image>
                  </ImageView>
                </graphic>
              </Button>
              <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminar" styleClass="Button" minHeight="46" minWidth="92" wrapText="true" maxWidth="Infinity">
                <graphic>
                  <ImageView fitWidth="28" fitHeight="28" preserveRatio="true" mouseTransparent="true">
                    <image>
                      <Image url="@../images/eliminar.png" />
                    </image>
                  </ImageView>
                </graphic>
              </Button>
              <Button fx:id="btnReportes" text="Reportes" onAction="#reportes" styleClass="Button" minHeight="46" minWidth="92" wrapText="true" maxWidth="Infinity">
                <graphic>
                  <ImageView fitWidth="28" fitHeight="28" preserveRatio="true" mouseTransparent="true">
                    <image>
                      <Image url="@../images/buscar.png" />
                    </image>
                  </ImageView>
                </graphic>
              </Button>
              <MenuButton text="Regresar" minHeight="46" styleClass="Button">
                <items>
                  <MenuItem fx:id="btnRegresar" text="Menu Principal" onAction="#handleButtonAction" />
                  <MenuItem fx:id="btnFactura" text="Factura" onAction="#handleButtonAction" />
                </items>
                <graphic>
                  <ImageView fitWidth="26" fitHeight="26" preserveRatio="true" mouseTransparent="true">
                    <image>
                      <Image url="@../images/atras.png" />
                    </image>
                  </ImageView>
                </graphic>
              </MenuButton>
            </TilePane>
            <VBox spacing="10" minWidth="0" VBox.vgrow="ALWAYS">
              <TableView fx:id="tblDetalleFactura" minWidth="0" minHeight="220" prefHeight="320" maxHeight="Infinity" editable="false" VBox.vgrow="ALWAYS" styleClass="tabla">
                <columns>
                  <TableColumn fx:id="colCodigo" text="Código de detalle" minWidth="85" prefWidth="153" editable="false" />
                  <TableColumn fx:id="colPrecioU" text="Precio unitario" minWidth="85" prefWidth="135" editable="false" />
                  <TableColumn fx:id="colCantidad" text="Cantidad" minWidth="85" prefWidth="110" editable="false" />
                  <TableColumn fx:id="colFactura" text="Número de factura" minWidth="85" prefWidth="153" editable="false" />
                  <TableColumn fx:id="colProducto" text="Código de producto" minWidth="85" prefWidth="162" editable="false" />
                </columns>
              </TableView>
            </VBox>
          </ResponsivePair>
        </VBox>
      </content>
    </ScrollPane>
  </center>
</BorderPane>
