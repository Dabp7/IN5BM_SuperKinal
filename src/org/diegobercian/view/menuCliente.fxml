<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import org.diegobercian.ui.ResponsiveGrid?>
<BorderPane xmlns="http://javafx.com/javafx/8.0.202" xmlns:fx="http://javafx.com/fxml/1" minWidth="0" styleClass="app-root" stylesheets="@../resourse/App.css" fx:controller="org.diegobercian.controller.MenuClientesController">
  <top>
    <VBox spacing="12" styleClass="page-header">
      <Label text="Clientes" styleClass="page-title" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity"/>
      <Label text="Consulta los registros o elige Agregar para crear uno nuevo." styleClass="muted" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity"/>
      <FlowPane hgap="8" vgap="8">
        <Button fx:id="btnAgregar" text="Agregar" onAction="#agregar" styleClass="primary-button" minHeight="38" minWidth="92" wrapText="true"/>
        <Button fx:id="btnEditar" text="Editar" onAction="#editar" styleClass="button" minHeight="38" minWidth="92" wrapText="true"/>
        <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminar" styleClass="button" minHeight="38" minWidth="92" wrapText="true"/>
        <Button fx:id="btnReportes" text="Reportes" onAction="#reportes" styleClass="button" minHeight="38" minWidth="92" wrapText="true"/>
        <Button fx:id="btnRegresarC" text="Inicio" onAction="#handleButtonAction" styleClass="button" minHeight="38" minWidth="92" wrapText="true"/>
      </FlowPane>
    </VBox>
  </top>
  <center>
    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="page-scroll">
      <content>
        <VBox spacing="16" fillWidth="true" minWidth="0" styleClass="page-body">
          <ResponsiveGrid fx:id="formGrid">
            <children>
              <VBox spacing="6" minWidth="0" styleClass="field-cell">
                <Label text="Código de cliente (automático)" styleClass="field-label" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity"/>
                <TextField fx:id="txtCodigoC" minWidth="0" maxWidth="Infinity" prefHeight="38"/>
              </VBox>
              <VBox spacing="6" minWidth="0" styleClass="field-cell">
                <Label text="NIT *" styleClass="field-label" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity"/>
                <TextField fx:id="txtNitC" minWidth="0" maxWidth="Infinity" prefHeight="38"/>
              </VBox>
              <VBox spacing="6" minWidth="0" styleClass="field-cell">
                <Label text="Nombres *" styleClass="field-label" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity"/>
                <TextField fx:id="txtNombreC" minWidth="0" maxWidth="Infinity" prefHeight="38"/>
              </VBox>
              <VBox spacing="6" minWidth="0" styleClass="field-cell">
                <Label text="Apellidos *" styleClass="field-label" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity"/>
                <TextField fx:id="txtApellidoC" minWidth="0" maxWidth="Infinity" prefHeight="38"/>
              </VBox>
              <VBox spacing="6" minWidth="0" styleClass="field-cell">
                <Label text="Dirección *" styleClass="field-label" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity"/>
                <TextField fx:id="txtDireccionC" minWidth="0" maxWidth="Infinity" prefHeight="38"/>
              </VBox>
              <VBox spacing="6" minWidth="0" styleClass="field-cell">
                <Label text="Teléfono *" styleClass="field-label" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity"/>
                <TextField fx:id="txtTelefonoC" minWidth="0" maxWidth="Infinity" prefHeight="38"/>
              </VBox>
              <VBox spacing="6" minWidth="0" styleClass="field-cell">
                <Label text="Correo electrónico *" styleClass="field-label" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity"/>
                <TextField fx:id="txtCorreoC" minWidth="0" maxWidth="Infinity" prefHeight="38"/>
              </VBox>
            </children>
          </ResponsiveGrid>
          <Label text="Los campos con * son obligatorios." styleClass="form-footnote" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity"/>
          <VBox spacing="10" minWidth="0" VBox.vgrow="ALWAYS">
            <Label text="Registros" styleClass="section-title" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity"/>
            <TableView fx:id="tblClientes" minWidth="0" minHeight="220" prefHeight="320" maxHeight="Infinity" editable="false" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colCodigoC" text="Código de cliente" minWidth="85" prefWidth="153" editable="false"/>
                <TableColumn fx:id="colNombreC" text="Nombres" minWidth="85" prefWidth="110" editable="false"/>
                <TableColumn fx:id="colApellidoC" text="Apellidos" minWidth="85" prefWidth="110" editable="false"/>
                <TableColumn fx:id="colNitC" text="NIT" minWidth="85" prefWidth="110" editable="false"/>
                <TableColumn fx:id="colDireccionC" text="Dirección" minWidth="85" prefWidth="110" editable="false"/>
                <TableColumn fx:id="colTelefonoC" text="Teléfono" minWidth="85" prefWidth="110" editable="false"/>
                <TableColumn fx:id="colCorreoC" text="Correo electrónico" minWidth="85" prefWidth="162" editable="false"/>
              </columns>
            </TableView>
          </VBox>
        </VBox>
      </content>
    </ScrollPane>
  </center>
</BorderPane>
