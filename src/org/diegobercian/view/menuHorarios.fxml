<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import org.diegobercian.ui.ResponsiveGrid?>
<?import org.diegobercian.ui.ResponsivePair?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" minWidth="0" styleClass="app-root" stylesheets="@../resourse/SuperKinalCSS.css" fx:controller="org.diegobercian.controller.MenuHorariosController" xmlns="http://javafx.com/javafx/8.0.202">
  <top>
    <VBox spacing="12" styleClass="page-header">
      <Label text="Horarios" styleClass="page-title centered" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity" />
      <Button fx:id="btnRegresar" text="Regresar" onAction="#handleButtonAction" styleClass="Button" minHeight="38" minWidth="92" wrapText="true">
        <graphic>
          <ImageView fitWidth="27" fitHeight="27" preserveRatio="true" mouseTransparent="true">
            <image>
              <Image url="@../images/atras.png" />
            </image>
          </ImageView>
        </graphic>
      </Button>
    </VBox>
  </top>
  <center>
    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER">
      <content>
        <VBox spacing="18" minWidth="0" styleClass="page-body info-body" alignment="TOP_CENTER">
          <ImageView fitWidth="102" fitHeight="102" preserveRatio="true" mouseTransparent="true">
            <image>
              <Image url="@../images/logo1.png" />
            </image>
          </ImageView>
          <Label text="ABIERTO" styleClass="page-title centered" wrapText="true" minWidth="0" minHeight="-Infinity" maxWidth="Infinity" />
          <Label text="De lunes a domingo" styleClass="info-line" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity" />
          <Label text="Mañanas: 6 a. m. a 11 a. m." styleClass="info-line" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity" />
          <Label text="Tardes: 2 p. m. a 8 p. m." styleClass="info-line" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity" />
          <Label text="Los horarios pueden cambiar durante los días festivos." styleClass="info-line" wrapText="true" minHeight="-Infinity" minWidth="0" maxWidth="Infinity" />
        </VBox>
      </content>
    </ScrollPane>
  </center>
</BorderPane>
