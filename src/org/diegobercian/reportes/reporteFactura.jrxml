<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reporteFactura" language="java" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" whenNoDataType="NoDataSection">
<parameter name="numeroFactura" class="java.lang.Integer"/>
<queryString><![CDATA[SELECT f.numeroFactura, f.fechaFactura, c.nombresCliente, c.apellidosCliente, c.NITClientes, c.direccionCliente, d.cantidad, p.descripcionProducto, d.precioUnitario, f.totalFactura FROM DetalleFactura d JOIN Factura f ON d.numeroFactura=f.numeroFactura JOIN Clientes c ON f.codigoCliente=c.codigoCliente JOIN Productos p ON d.codigoProducto=p.codigoProducto WHERE f.numeroFactura=$P{numeroFactura} ORDER BY d.codigoDetalleFactura]]></queryString>
<field name="numeroFactura" class="java.lang.Integer"/>
<field name="fechaFactura" class="java.sql.Date"/>
<field name="nombresCliente" class="java.lang.String"/>
<field name="apellidosCliente" class="java.lang.String"/>
<field name="NITClientes" class="java.lang.String"/>
<field name="direccionCliente" class="java.lang.String"/>
<field name="cantidad" class="java.lang.Integer"/>
<field name="descripcionProducto" class="java.lang.String"/>
<field name="precioUnitario" class="java.math.BigDecimal"/>
<field name="totalFactura" class="java.math.BigDecimal"/>
<title><band height="165"><image><reportElement x="0" y="0" width="160" height="55"/><imageExpression><![CDATA[org.diegobercian.reportes.GenerarReportes.class.getResource("/org/diegobercian/images/Facturas.png")]]></imageExpression></image><textField><reportElement x="300" y="10" width="235" height="30"/><textElement><font size="20" isBold="true"/></textElement><textFieldExpression><![CDATA["Factura " + $F{numeroFactura}]]></textFieldExpression></textField><textField><reportElement x="300" y="45" width="235" height="20"/><textElement><font size="11" isBold="false"/></textElement><textFieldExpression><![CDATA["Fecha: " + $F{fechaFactura}]]></textFieldExpression></textField><textField><reportElement x="0" y="80" width="535" height="20"/><textElement><font size="12" isBold="true"/></textElement><textFieldExpression><![CDATA["Cliente: " + $F{nombresCliente} + " " + $F{apellidosCliente}]]></textFieldExpression></textField><textField><reportElement x="0" y="105" width="535" height="20"/><textElement><font size="11" isBold="false"/></textElement><textFieldExpression><![CDATA["NIT: " + $F{NITClientes}]]></textFieldExpression></textField><textField><reportElement x="0" y="130" width="535" height="25"/><textElement><font size="11" isBold="false"/></textElement><textFieldExpression><![CDATA["Dirección: " + $F{direccionCliente}]]></textFieldExpression></textField></band></title><columnHeader><band height="30"><textField><reportElement x="0" y="5" width="65" height="20"/><textElement><font size="11" isBold="true"/></textElement><textFieldExpression><![CDATA["Cantidad"]]></textFieldExpression></textField><textField><reportElement x="70" y="5" width="275" height="20"/><textElement><font size="11" isBold="true"/></textElement><textFieldExpression><![CDATA["Producto"]]></textFieldExpression></textField><textField><reportElement x="350" y="5" width="85" height="20"/><textElement><font size="11" isBold="true"/></textElement><textFieldExpression><![CDATA["Precio Q"]]></textFieldExpression></textField><textField><reportElement x="440" y="5" width="95" height="20"/><textElement><font size="11" isBold="true"/></textElement><textFieldExpression><![CDATA["Importe Q"]]></textFieldExpression></textField></band></columnHeader><detail><band height="24"><textField><reportElement x="0" y="2" width="65" height="20"/><textElement><font size="11" isBold="false"/></textElement><textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression></textField><textField><reportElement x="70" y="2" width="275" height="20"/><textElement><font size="11" isBold="false"/></textElement><textFieldExpression><![CDATA[$F{descripcionProducto}]]></textFieldExpression></textField><textField><reportElement x="350" y="2" width="85" height="20"/><textElement><font size="11" isBold="false"/></textElement><textFieldExpression><![CDATA[$F{precioUnitario}.toPlainString()]]></textFieldExpression></textField><textField><reportElement x="440" y="2" width="95" height="20"/><textElement><font size="11" isBold="false"/></textElement><textFieldExpression><![CDATA[$F{precioUnitario}.multiply(java.math.BigDecimal.valueOf($F{cantidad})).setScale(2).toPlainString()]]></textFieldExpression></textField></band></detail><summary><band height="105"><textField><reportElement x="270" y="15" width="265" height="22"/><textElement><font size="11" isBold="false"/></textElement><textFieldExpression><![CDATA["Total sin IVA: Q " + $F{totalFactura}.divide(new java.math.BigDecimal("1.12"), 2, java.math.RoundingMode.HALF_UP)]]></textFieldExpression></textField><textField><reportElement x="270" y="40" width="265" height="22"/><textElement><font size="11" isBold="false"/></textElement><textFieldExpression><![CDATA["IVA: Q " + $F{totalFactura}.subtract($F{totalFactura}.divide(new java.math.BigDecimal("1.12"), 2, java.math.RoundingMode.HALF_UP))]]></textFieldExpression></textField><textField><reportElement x="270" y="70" width="265" height="25"/><textElement><font size="14" isBold="true"/></textElement><textFieldExpression><![CDATA["Total factura: Q " + $F{totalFactura}]]></textFieldExpression></textField></band></summary><noData><band height="60"><textField><reportElement x="0" y="15" width="535" height="20"/><textElement><font size="11" isBold="true"/></textElement><textFieldExpression><![CDATA["La factura seleccionada no contiene detalles."]]></textFieldExpression></textField></band></noData></jasperReport>